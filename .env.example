# Server Port
PORT=3000

# Google Gemini API Keys (comma-separated for multi-key auto-failover & rate-limit rotation)
# Example: GEMINI_API_KEYS=AIzaSyA123...,AIzaSyB456...,AIzaSyC789...
GEMINI_API_KEYS=

# Preferred Gemini Model (default: gemini-2.5-flash or gemini-1.5-flash for free tier)
GEMINI_MODEL=gemini-2.5-flash

# Default Application Mode: "review" (ask user to verify before submit) or "auto" (full auto-pilot)
DEFAULT_APP_MODE=review

# Headless browser mode: false lets you watch the real browser live, true runs silently in background
HEADLESS=false
